# ── Database ───────────────────────────────────────────────────────────
# Replace with your production database credentials (Aiven, PlanetScale, etc.)
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_HOST:PORT/YOUR_DB_NAME?ssl-mode=REQUIRED
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# ── AI Providers ────────────────────────────────────────────────────────
# Get your free Gemini API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_ENABLED=true

# Get your free OpenRouter key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_ENABLED=false

# Get Cloudflare credentials at: https://dash.cloudflare.com → AI → Workers AI
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ENABLED=false

# ── CORS ────────────────────────────────────────────────────────────────
# Replace with your actual deployed frontend URL
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Rate Limiting ───────────────────────────────────────────────────────
RATELIMIT_AI_DAILY_LIMIT=20
