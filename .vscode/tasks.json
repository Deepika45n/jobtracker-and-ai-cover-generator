{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Backend (Spring Boot)",
            "type": "shell",
            "command": ".\\mvnw.cmd",
            "args": [
                "spring-boot:run"
            ],
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "app"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Frontend (Vite)",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "app"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Full App",
            "dependsOn": [
                "Run Backend (Spring Boot)",
                "Run Frontend (Vite)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}
